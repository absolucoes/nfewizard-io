{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "src/config/**/*.json",
    "examples/**/*.json"
  ],
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../shared"
    }
  ]
}
